# Backend Environment Variables
# Copy this file to .env and fill in the values

# Server Config
PORT=5000
DEBUG=True

# Google Gemini API Key (Optional - users can also provide via UI)
# Get free key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Cookie Config for yt-dlp (needed for age-restricted/login-required videos)
# Option 1: Set browser name: edge, firefox, brave, chromium, safari, opera
#            WARNING: "chrome" does NOT work on Windows (DPAPI encryption issue)
# Option 2: Place a cookies.txt (Netscape format) in the backend/ folder
#            Export using browser extension like "Get cookies.txt LOCALLY"
# Leave empty to auto-detect cookies.txt file, or disable if no file exists
COOKIES_FROM_BROWSER=edge
